# Configuración privada del servidor. No subir .env al repositorio.
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b-cloud
SUPABASE_URL=
# Clave publicable (sb_publishable_...) o anon, nunca service_role.
SUPABASE_PUBLISHABLE_KEY=
# URL de la aplicación; la callback es APP_URL/auth/callback.
APP_URL=https://monitor-presupuesto.vercel.app
PORT=3000
NGROK_AUTHTOKEN=
