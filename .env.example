# Solo servidor. Nunca usar prefijos VITE_ para secretos.
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b-cloud
# Archivo SQLite persistente para desarrollo local.
DATABASE_URL=file:./data/presupuesto.db
# En Vercel: reemplazar DATABASE_URL por libsql://... de una base libSQL/Turso.
DATABASE_AUTH_TOKEN=
# Obligatoria en Vercel, minimo 16 caracteres; protege el espacio de trabajo compartido.
APP_PASSWORD=
PORT=3000
